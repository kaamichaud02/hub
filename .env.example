# ── hub (FastAPI) ──────────────────────────────────────────────
HUB_DB_HOST=
HUB_DB_PORT=5432
HUB_DB_NAME=hub_kaa_zone
HUB_DB_USER=hub
HUB_DB_PASSWORD=

# ── Cloudflare Access (une seule app Zero Trust protège tout le hub,
# suivi_temps inclus depuis sa fusion dans ce même service) ──────
CF_ACCESS_TEAM_DOMAIN=
# AUD tag de l'application Cloudflare Access du hub (Zero Trust > Access >
# Applications > hubtest/hub > Overview)
CF_ACCESS_AUD=

# ── Suivi de temps (fusionné dans hub-app — connexion à la base Postgres
# EXISTANTE de l'ancienne app Django, tables auth_user/timesheets_*) ──
ST_DATABASE_NAME=
ST_DATABASE_USER=
ST_DATABASE_PASSWORD=
ST_DATABASE_HOST=
ST_DATABASE_PORT=5432

# ── Recette (extraction IA via Claude) ────────────────────────────
# Clé API Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=
